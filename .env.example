# Copy these into your hosting dashboard (Render: Environment). Never commit real values.

SECRET_KEY=change-me-to-a-long-random-string
# Password for /admin (stores, gifts, photos, refunds, payouts). Required on the hosted site.
ADMIN_PASSWORD=
# Demo stores (KFC, Java House...) load only on your own computer. 1 forces them on, 0 off.
SEED_DEMO_STORES=
# Shared demo PIN: works only on your own computer, for stores without their own PIN.
CASHIER_PIN=change-me
# Each store's own PIN (6-12 digits). Or set them with:  flask --app app set-store-pin "Java House"
STORE_PINS=                    # e.g.  Java House:482913; KFC:771100

# Real payments with Pesapal (MTN Mobile Money, Airtel Money, cards).
# Leave the keys empty to run the simulated demo instead.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox            # "sandbox" while testing, "live" after Pesapal approves your account
PESAPAL_IPN_ID=                # optional: registered automatically on the first payment

# The public https address of the site. Pesapal sends payment updates here.
# Not needed on Render: it is detected automatically.
PUBLIC_BASE_URL=https://your-app.onrender.com

# WhatsApp help line shown as a chat button (country code, digits only). Leave empty to hide it.
SUPPORT_WHATSAPP=

# SMS with Africa's Talking. Leave AT_API_KEY empty to simulate texts (read them at /dev/sms locally).
AT_USERNAME=sandbox            # "sandbox" for testing, your app username when live
AT_API_KEY=
AT_SENDER_ID=                  # optional approved sender name, live only

# Smart Gifting's fee on each collected gift, in percent (used for store payouts)
STORE_COMMISSION_PERCENT=5
